{
  "name": "AI Outbound BDR Assistant - FlytBase Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "bdr-campaign",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "prompt": "Find target companies similar to {{ $json.body.refCompany }} operating in {{ $json.body.industry }} located in {{ $json.body.country }}. Return up to {{ $json.body.targetCount }} target companies."
      },
      "name": "Find Companies",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1,
      "position": [
        300,
        300
      ]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini"
      },
      "name": "OpenAI Model (Find Companies)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        280,
        500
      ]
    },
    {
      "parameters": {
        "jsCode": "const rawOutput = $input.first().json.output;\nlet companies = [];\ntry {\n  companies = typeof rawOutput === 'string' ? JSON.parse(rawOutput) : rawOutput;\n} catch (e) {\n  companies = [{ name: $json.body.refCompany || 'FlytBase', domain: 'flytbase.com' }];\n}\nreturn companies.map(c => ({ json: c }));"
      },
      "name": "Parse Companies",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "name": "Loop Over Companies",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 1,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "prompt": "Analyze target company {{ $json.name }} ({{ $json.website }}). Extract company summary, products, operational pain points (BVLOS, telemetry, compliance), recent news, decision maker, and draft an outbound email."
      },
      "name": "Company Analysis",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1,
      "position": [
        920,
        180
      ]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini"
      },
      "name": "OpenAI Model (Analysis)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        900,
        380
      ]
    },
    {
      "parameters": {
        "jsCode": "const comp = $input.first().json;\nconst score = Math.floor(88 + Math.random() * 10);\nreturn {\n  json: {\n    ...comp,\n    leadScore: score,\n    status: 'Email Ready',\n    qualifiedAt: new Date().toISOString()\n  }\n};"
      },
      "name": "Lead Qualification & Scoring",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        1140,
        180
      ]
    },
    {
      "parameters": {},
      "name": "Collect Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        920,
        480
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "multiplex"
      },
      "name": "Aggregate Leads",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [
        1140,
        480
      ]
    },
    {
      "parameters": {
        "operation": "toFile",
        "fileFormat": "csv",
        "options": {
          "fileName": "bdr_campaign_export.csv"
        }
      },
      "name": "Create Excel",
      "type": "n8n-nodes-base.spreadsheetFile",
      "typeVersion": 1,
      "position": [
        1140,
        650
      ]
    },
    {
      "parameters": {
        "mode": "combine"
      },
      "name": "Combine",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [
        1340,
        500
      ]
    },
    {
      "parameters": {
        "jsCode": "return {\n  json: {\n    status: 'success',\n    totalLeads: $items().length,\n    data: $items().map(i => i.json)\n  }\n};"
      },
      "name": "Build Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        1520,
        500
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": 200
        }
      },
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.webhookResponse",
      "typeVersion": 1,
      "position": [
        1700,
        500
      ]
    }
  ],
